{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "backend/**",
      "excludeFiles": [
        ".venv/**",
        ".venv310/**",
        ".vercel/**",
        ".ruff_cache/**",
        "data/**",
        "foundationDownload.json",
        "backend/foundationDownload.json"
      ]
    }
  }
}
